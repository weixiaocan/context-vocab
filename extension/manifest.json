{
  "manifest_version": 3,
  "name": "生词卡",
  "version": "0.1.0",
  "description": "划词查词，并把想记住的词加入生词卡。",
  "permissions": ["storage"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core.js", "api.js", "content.js"],
      "css": ["popup.css"],
      "run_at": "document_idle"
    }
  ]
}
